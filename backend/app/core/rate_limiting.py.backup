from fastapi import HTTPException, Request
from fastapi.responses import JSONResponse
import time
import asyncio
import logging

# Create module-specific logger
logger = logging.getLogger("safe_zone.rate_limiting")

# Simple in-memory rate limiting (replace with Redis in production)
class RateLimiter:
    def __init__(self):
        self.requests = {}
        self.last_cleanup = time.time()

    async def check_rate_limit(self, request: Request, identifier: str = None):
        # Import settings here to avoid circular imports
        from app.core.config import settings

        # Clean up old entries periodically (every 5 minutes)
        current_time = time.time()
        if current_time - self.last_cleanup > 300:  # 5 minutes
            self._cleanup_old_entries(current_time)
            self.last_cleanup = current_time

        if settings.environment == "test":
            return True

        client_ip = request.client.host
        key = identifier or client_ip

        if key not in self.requests:
            self.requests[key] = []

        # Remove requests older than 1 minute
        window_start = current_time - 60
        self.requests[key] = [req_time for req_time in self.requests[key] if req_time > window_start]

        # Check if under limit
        if len(self.requests[key]) >= settings.rate_limit_per_minute:
            logger.warning(f"Rate limit exceeded for {key}. Requests in last minute: {len(self.requests[key])}")
            raise HTTPException(
                status_code=429,
                detail={
                    "error": "rate_limit_exceeded",
                    "message": f"Too many requests ({len(self.requests[key])}/{settings.rate_limit_per_minute}). Please try again in a minute."
                }
            )

        # Add current request
        self.requests[key].append(current_time)
        logger.debug(f"Request from {key}. Count: {len(self.requests[key])}/{settings.rate_limit_per_minute}")
        return True

    def _cleanup_old_entries(self, current_time):
        """Remove entries older than 2 minutes to prevent memory leaks"""
        cutoff = current_time - 120  # 2 minutes
        keys_to_remove = []
        
        for key, timestamps in self.requests.items():
            # Remove timestamps older than cutoff
            self.requests[key] = [ts for ts in timestamps if ts > cutoff]
            # Remove key if no timestamps left
            if not self.requests[key]:
                keys_to_remove.append(key)
        
        for key in keys_to_remove:
            del self.requests[key]
        
        logger.debug(f"Rate limit cleanup completed. Removed {len(keys_to_remove)} old entries.")

# Global rate limiter instance
rate_limiter = RateLimiter()

# Rate limiting middleware
async def rate_limit_middleware(request: Request, call_next):
    # Import settings at the function level to ensure it's available
    from app.core.config import settings
    
    # Skip rate limiting for docs and health endpoints
    if request.url.path in ["/docs", "/redoc", "/openapi.json", "/api/v1/health"]:
        return await call_next(request)

    try:
        await rate_limiter.check_rate_limit(request)
        response = await call_next(request)

        # Add rate limit headers
        response.headers["X-RateLimit-Limit"] = str(settings.rate_limit_per_minute)
        return response

    except HTTPException as e:
        return JSONResponse(
            status_code=e.status_code,
            content=e.detail,
            headers={
                "X-RateLimit-Limit": str(settings.rate_limit_per_minute),
                "X-RateLimit-Reset": str(int(time.time() + 60))
            }
        )
