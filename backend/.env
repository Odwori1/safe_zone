# ===========================================
# SAFE ZONE BACKEND CONFIGURATION
# ===========================================

# Database Configuration
DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=safe_zone
DB_USER=safe_zone_app_user
DB_PASSWORD=secure_app_password_2024

# Security
ENVIRONMENT=development
SECRET_KEY=your-super-secret-key-for-jwt-tokens-2024-safe-zone
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Server
HOST=0.0.0.0
PORT=8001
CORS_ORIGINS=http://localhost:3001

# Rate Limiting
RATE_LIMIT_PER_MINUTE=100

# Timezone & Internationalization
DEFAULT_TIMEZONE=UTC
SUPPORTED_LOCALES=en-US,es-ES,fr-FR,de-DE,pt-BR,zh-CN,ja-JP

# Logging
LOG_LEVEL=INFO

# S3 Configuration for Phase 3, Item 3
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here  
AWS_REGION=us-east-1
S3_BUCKET=safe-zone-media
S3_PRESIGNED_EXPIRY=3600
